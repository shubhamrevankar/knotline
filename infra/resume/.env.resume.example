# Public identity
KNOTLINE_DOMAIN=demo.example.com
ACME_EMAIL=you@example.com

# Google OAuth (callback: https://demo.example.com/callbacks/v1/identity/oauth/google)
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Transactional email (Resend has a free tier; verify the sender domain first)
KNOTLINE_EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=Knotline <hello@demo.example.com>

# Live AI
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_QUALITY_MODEL=gpt-5.6-sol
OPENAI_JUDGE_MODEL=gpt-5.6-sol
OPENAI_PRICE_VERSION=resume-demo-unpriced

# Generate each value independently; do not reuse secrets.
POSTGRES_PASSWORD=
KNOTLINE_RUNTIME_DB_PASSWORD=
MODEL_GATEWAY_SAFETY_SALT=
MODEL_GATEWAY_INTERNAL_TOKEN=
TOOL_BROKER_INTERNAL_TOKEN=
TOOL_BROKER_LOCAL_KEY=
TOOL_BROKER_RECORDED_CREDENTIAL=
SANDBOX_INTERNAL_TOKEN=
MINIO_ROOT_USER=knotline
MINIO_ROOT_PASSWORD=
AUTH_TRANSACTION_ENCRYPTION_KEY=

# These four values must be base64 encodings of exactly 32 random bytes.
EVALUATION_FIXTURE_KEY=
FILE_SCANNER_ATTESTATION_KEY=
AUTHORIZATION_PROOF_SIGNING_KEY=
CONNECTOR_STATE_SIGNING_KEY=
