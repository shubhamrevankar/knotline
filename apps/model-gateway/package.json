  },
  "dependencies": {
    "@knotline/contracts": "workspace:*",
    "@knotline/model-gateway": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
