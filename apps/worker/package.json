{
  "name": "@knotline/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/worker/src",
    "test:unit": "vitest run --root ../.. apps/worker/src",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@knotline/agent-runtime": "workspace:*",
    "@knotline/connector-sdk": "workspace:*",
    "@knotline/contracts": "workspace:*",
    "@knotline/db": "workspace:*",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
