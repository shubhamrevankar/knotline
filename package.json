{
  "name": "knotline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' build",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @knotline/api --filter @knotline/web --filter @knotline/worker dev",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "contracts:check": "node tooling/quality/plan-contract.mjs check",
    "contracts:generate": "node tooling/quality/plan-contract.mjs generate",
    "evidence:check": "node tooling/gate/evidence.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "pnpm build:packages",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm test:unit",
    "test:a11y": "playwright test --grep @a11y",
    "pretest:a11y": "pnpm build:packages",
    "test:browser": "pnpm test:e2e",
    "test:contracts": "node --test tooling/quality/*.test.mjs tooling/gate/*.test.mjs",
    "test:e2e": "playwright test",
    "test:evals": "pnpm --filter @knotline/agent-evaluation test",
    "test:files": "pnpm --filter @knotline/document-processing test",
    "test:retrieval": "pnpm --filter @knotline/retrieval test && tsx tooling/retrieval/search-1m-profile.ts && pnpm test:api",
    "test:graph": "pnpm --filter @knotline/knowledge-graph test && pnpm test:api",
    "test:connectors": "pnpm --filter @knotline/connector-sdk test && pnpm test:api",
    "pretest:e2e": "pnpm build:packages",
    "test:integration": "bash tooling/containers/test-services.sh",
    "test:auth": "tsx tooling/auth/postgres-suite.ts",
    "test:api": "tsx tooling/workflows/postgres-suite.ts",
    "test:property": "vitest run packages/contracts/src/workflow-definition.test.ts packages/contracts/src/workflow-generation.test.ts packages/contracts/src/collaboration.test.ts packages/contracts/src/runtime.test.ts packages/contracts/src/human-task.test.ts packages/contracts/src/approval.test.ts packages/contracts/src/agent.test.ts apps/web/src/studio-reducer.test.ts",
    "test:runtime": "pnpm test:api && vitest run packages/contracts/src/runtime.test.ts apps/worker/src/workflows.test.ts",
    "test:workspace": "tsx tooling/workspace/postgres-suite.ts",
    "test:workflows": "tsx tooling/workflows/postgres-suite.ts",
    "test:db": "tsx tooling/db/postgres-suite.ts integration",
    "test:rls": "tsx tooling/db/postgres-suite.ts rls",
    "test:unit": "tsx scripts/quality/assert-test-suites.ts && vitest run --coverage",
    "pretest:unit": "pnpm build:packages",
    "test:visual": "playwright test --grep @visual",
    "pretest:visual": "pnpm build:packages",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json --noEmit",
    "verify": "tsx scripts/quality/run-gate.ts",
    "preverify:boundaries": "pnpm build:packages",
    "verify:boundaries": "node tooling/boundaries/verify.mjs && dependency-cruiser apps packages scripts tooling --config dependency-cruiser.config.mjs --output-type err-long",
    "verify:brand": "node tooling/brand/verify.mjs --self-test && node tooling/brand/verify.mjs",
    "verify:containers": "bash tooling/containers/test-containers.sh",
    "verify:contracts": "pnpm contracts:check",
    "verify:evidence": "pnpm evidence:check",
    "verify:events": "tsx tooling/events/registry.ts self-test && tsx tooling/events/registry.ts check",
    "preverify:events": "pnpm --filter @knotline/contracts build",
    "verify:licenses": "node tooling/scans/licenses.mjs && node tooling/scans/sbom.mjs --self-test && node tooling/scans/sbom.mjs",
    "verify:localization": "node tooling/localization/verify.mjs --self-test && node tooling/localization/verify.mjs",
    "verify:migrations": "tsx tooling/db/postgres-suite.ts migrations && pnpm --filter @knotline/db registry:check",
    "verify:query-plan": "tsx tooling/db/postgres-suite.ts migrations",
    "verify:backup": "tsx tooling/db/postgres-suite.ts migrations",
    "verify:secrets": "bash tooling/scans/secrets.sh",
    "verify:web-routes": "tsx tooling/routes/verify-web-manifest.ts",
    "verify:web-performance": "pnpm --filter @knotline/web build && node tooling/performance/bundle-budget.mjs --self-test && node tooling/performance/bundle-budget.mjs",
    "verify:dependencies": "bash tooling/scans/dependencies.sh",
    "verify:openapi": "tsx tooling/contracts/openapi.ts check",
    "preverify:openapi": "pnpm --filter @knotline/contracts build",
    "verify:reproducible-build": "tsx scripts/quality/verify-reproducible-build.ts",
    "generate:events": "tsx tooling/events/registry.ts generate",
    "pregenerate:events": "pnpm --filter @knotline/contracts build",
    "generate:localization": "node tooling/localization/verify.mjs generate",
    "generate:openapi": "tsx tooling/contracts/openapi.ts generate",
    "pregenerate:openapi": "pnpm --filter @knotline/contracts build",
    "local:up": "docker compose -f infra/docker-compose.yml up --build",
    "local:infra:up": "docker compose -f infra/docker-compose.yml up -d postgres redis minio mailpit temporal temporal-ui",
    "local:preview": "pnpm local:infra:up && set -a && . ./.env.example && set +a && pnpm dev",
    "local:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.8.0",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@knotline/contracts": "workspace:*",
    "zod": "4.1.12"
  }
}
