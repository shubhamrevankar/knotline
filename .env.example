KNOTLINE_ENV=local
KNOTLINE_API_PORT=4100
KNOTLINE_API_ORIGIN=http://localhost:4100
KNOTLINE_WEB_ORIGIN=http://localhost:5173
KNOTLINE_TRUSTED_PROXY=
VITE_API_URL=http://localhost:4100
VITE_DEMO_MODE=false
VITE_WORKSPACE_ID=10000000-0000-4000-8000-000000000001
AUTH_TRANSACTION_ENCRYPTION_KEY=local-only-knotline-auth-encryption-key
GOOGLE_OIDC_ISSUER=http://localhost:4100/__local/oidc
GOOGLE_OIDC_CLIENT_ID=knotline-local-client
GOOGLE_OIDC_CLIENT_SECRET=local-only-provider-secret
GOOGLE_OIDC_AUTHORIZATION_ENDPOINT=http://localhost:4100/__local/oidc/authorize
GOOGLE_OIDC_TOKEN_ENDPOINT=http://localhost:4100/__local/oidc/token
GOOGLE_OIDC_JWKS_URI=http://localhost:4100/__local/oidc/keys
AWS_SES_REGION=us-east-1
AUTH_EMAIL_FROM=signin@localhost.invalid
DATABASE_URL=postgresql://knotline_runtime:local-only-runtime-password@localhost:5432/knotline
DB_MIGRATION_URL=postgresql://knotline_local:local-only-postgres-password@localhost:5432/knotline
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_ACCESS_KEY_REFERENCE=local-only:knotline
S3_SECRET_KEY_REFERENCE=local-only:knotline-local-only-password
