{
  "name": "@knotline/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "registry"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:unit": "vitest run src",
    "lint": "eslint src --max-warnings 0",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "generate": "tsx src/cli.ts generate",
    "registry:check": "tsx src/cli.ts registry-check"
  },
  "dependencies": {
    "@knotline/contracts": "workspace:*",
    "@knotline/operations": "workspace:*",
    "@knotline/retrieval": "workspace:*",
    "@knotline/knowledge-graph": "workspace:*",
    "@knotline/connector-sdk": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.16.0",
    "tsx": "4.23.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
